{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": false,
    "allowJs": false,
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "outDir": "dist/assets",
    "rootDir": "src",
    "sourceMap": false
  },
  "include": ["src/**/*.ts"]
}
